# Weights & Biases credentials for training telemetry.
# First-time setup:  cp wandb.env.example wandb.env  and paste your API key
# from https://wandb.ai/authorize. wandb.env is gitignored; never commit it.
WANDB_API_KEY=
# Optional: log to a team space instead of your personal one.
# WANDB_ENTITY=
# Optional: record runs locally and upload later with `wandb sync` (clusters
# without internet egress).
# WANDB_MODE=offline
